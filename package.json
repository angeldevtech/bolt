{
  "name": "bolt",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:check": "tsc -b",
    "build:vite": "vite build",
    "prepare:binaries": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/provision-binaries.ps1",
    "build:tauri": "bun run tauri build",
    "build:tauri:diagnostic": "bun run tauri build -- --features diagnostic",
    "build": "bun run build:check && bun run build:vite",
    "test:frontend": "bun test tests/frontend/critical-regression.test.ts && vitest run --config vitest.config.ts tests/frontend/update-modal.test.ts",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml --lib",
    "test:critical": "bun run test:frontend && bun run test:rust",
    "release:check": "bun run test:critical && bun run build:tauri",
    "preview": "vite preview"
  },
  "dependencies": {
    "@kobalte/core": "^0.13.11",
    "@tauri-apps/plugin-clipboard-manager": "~2",
    "@tauri-apps/plugin-dialog": "~2",
    "@tauri-apps/plugin-fs": "~2",
    "@tauri-apps/plugin-process": "~2",
    "@tauri-apps/plugin-shell": "~2",
    "@tauri-apps/plugin-store": "~2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-solid": "^1.7.0",
    "solid-js": "^1.9.11",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@solidjs/testing-library": "^0.8.10",
    "@tailwindcss/vite": "^4.2.2",
    "@tauri-apps/cli": "^2.10.1",
    "@types/node": "^24.12.0",
    "happy-dom": "^20.11.1",
    "tailwindcss": "^4.2.2",
    "typescript": "~5.9.3",
    "vite": "^8.0.1",
    "vite-plugin-solid": "^2.11.11",
    "vitest": "^4.1.10"
  }
}
